# copy to .env.local for local dev, and add the same keys in vercel → project → settings → environment variables

# 32+ random characters. signs the login cookie. generate: openssl rand -base64 48
SESSION_SECRET=

# upstash redis (vercel → storage → upstash for redis fills KV_REST_API_URL / KV_REST_API_TOKEN for you)
# without these, local dev stores data in .data/store.json
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# a solana mainnet rpc (helius / quicknode free tier). the public one rate-limits hard.
SOLANA_RPC_URL=
